        "    resultados_pe[nombre] = dict(p=p, gamma=p.gamma, v=p.rapidez, Om=Om, T_c=T_c, rho_med=rho_med, rho_teo=rho_teo,\n",
        "                                 tau_b=tau_b, T_reb=T_reb, T_der=T_der, om=om, N=N, cpu=tr.cpu, dE=np.max(np.abs(np.sum(tr.v**2, axis=1)/np.sum(v0**2) - 1)),\n",
