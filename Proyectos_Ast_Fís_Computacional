        "# @title\n",
        "A_g, B0_g = 1.0, 1.0\n",
        "campo_g = lambda r: np.array([0.0, 0.0, A_g*r[0] + B0_g])\n",
        "res_g, tray_g = {}, {}\n",
        "for v, T, dt in [(1.0, 200.0, 0.005), (0.1, 1000.0, 0.01)]:\n",
        "    p = Particula(q=1.0, m=1.0, rapidez=v)\n",
        "    N = int(round(T/dt))\n",
        "    tr = simular_particula(p, campo_g, np.zeros(3), np.array([0.0, v, 0.0]), dt, N, cada=10, metodo=\"boris\")\n",
        "    v_med = np.polyfit(tr.t, tr.x[:, 1], 1)[0]                    # velocidad media en y = deriva\n",
        "    x_c = 0.5*(tr.x[:, 0].min() + tr.x[:, 0].max())               # centro de la órbita en x\n",
        "    v_teo = p.M*v**2*A_g/(2*p.q*(A_g*x_c + B0_g)**2)\n",
        "    res_g[v] = (v_med, v_teo, x_c); tray_g[v] = tr\n",
        "    rho_min = p.M*v/(p.q*(A_g*tr.x[:, 0].max() + B0_g)); rho_max = p.M*v/(p.q*B0_g)\n",
        "    print(f\"v={v}: deriva medida = {v_med:.5f} m/s | teoría (B en el centro, x_c={x_c:.3f}) = {v_teo:.5f} m/s | diferencia = {100*(v_med/v_teo-1):+.2f} %\")\n",
        "    print(f\"      radio local de giro: {rho_max:.3f} m donde B es débil (x=0) y {rho_min:.3f} m donde B es fuerte (x={tr.x[:, 0].max():.3f})\")\n",
        "    print(f\"      deriva de |v|^2 relativa: {np.max(np.abs(np.sum(tr.v**2, axis=1)/v**2 - 1)):.1e}\")\n",
        "\n",
        "fig, axs = plt.subplots(1, 3, figsize=(14, 4.6))\n",
        "for ax, v, t_ventana in [(axs[0], 1.0, 16.0), (axs[1], 0.1, 70.0)]:\n",
        "    tr = tray_g[v]; m_ = tr.t <= t_ventana\n",
        "    ax.plot(tr.x[m_, 0], tr.x[m_, 1], lw=0.9, label=\"partícula\")\n",
        "    ax.axvline(res_g[v][2], color='k', ls='--', lw=0.7, label=\"eje de la órbita\")\n",
        "    ax.set_aspect('equal'); ax.set_xlabel(\"x (m)\"); ax.set_ylabel(\"y (m)\")\n",
        "    ax.set_title(f\"v = {v} m/s (ρ/L_B ≈ {v:.1f}), primeros {t_ventana:.0f} s\"); ax.legend(fontsize=7, loc='lower center')\n",
        "ax = axs[2]\n",
        "for v, col in [(1.0, 'tab:blue'), (0.1, 'tab:orange')]:\n",
        "    tr = tray_g[v]\n",
        "    ax.plot(tr.t, tr.x[:, 1], color=col, label=f\"v = {v}: simulación\")\n",
        "    ax.plot(tr.t, res_g[v][1]*tr.t, '--', color='k', lw=0.8)\n",
