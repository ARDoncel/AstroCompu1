      "source": [
        "# @title\n",
        "def det_cofactores(M):\n",
        "    \"\"\"Determinante por expansión de cofactores a lo largo de la primera fila (recursivo).\"\"\"\n",
        "    M = np.asarray(M, float)\n",
        "    n = M.shape[0]\n",
        "    if n == 1:\n",
        "        return M[0, 0]\n",
        "    if n == 2:\n",
        "        return M[0, 0]*M[1, 1] - M[0, 1]*M[1, 0]\n",
        "    det = 0.0\n",
        "    for j in range(n):\n",
        "        menor = np.delete(np.delete(M, 0, axis=0), j, axis=1)   # quitar fila 0 y columna j\n",
        "        det += (-1)**j * M[0, j] * det_cofactores(menor)        # signo del cofactor\n",
        "    return det\n",
        "\n",
        "def pesos_derivada_cramer(n, s, h=1.0):\n",
        "    \"\"\"Mismos pesos que pesos_derivada, pero por cofactores.\"\"\"\n",
        "    x = np.arange(n+1, dtype=float)                                   # nodos en unidades de h\n",
        "    A = np.array([[x[j]**m for j in range(n+1)] for m in range(n+1)]) # A[m, j] = x_j^m\n",
        "    b = np.array([0.0 if m == 0 else m*x[s]**(m-1) for m in range(n+1)])\n",
        "    D = det_cofactores(A)\n",
        "    w = np.zeros(n+1)\n",
        "    for j in range(n+1):\n",
        "        Aj = A.copy()\n",
        "        Aj[:, j] = b                                                   # columna j -> b\n",
        "        w[j] = det_cofactores(Aj)/D\n",
        "    return w/h\n",
        "\n",
        "dif_max = 0.0\n",
        "n = 2\n",
        "for s in range(n+1):\n",
        "  dif_max = max(dif_max, np.max(np.abs(pesos_derivada(n, s, 0.1) - pesos_derivada_cramer(n, s, 0.1))))\n",
        "print(\"Diferencia Máxima, Pesos por Lagrange vs Cramer\", dif_max)"
      ]
