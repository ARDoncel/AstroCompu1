        "# @title\n",
        "def coef_error(n, s):\n",
        "    \"\"\"C_{n,s} = prod_{k != s}(s-k) / (n+1)!   ->   LTE = C * h^n * f^(n+1)(xi)\"\"\"\n",
        "    prod = 1.0\n",
        "    for k in range(n+1):\n",
        "        if k != s:\n",
        "            prod *= (s - k)\n",
        "    return prod/np.prod(np.arange(1, n+2))\n",
        "\n",
        "def error_empirico(n, s, h, x0=0.3):\n",
        "    \"\"\"(f'_exacta - f'_aprox) con nodos x0 + (j-s)h.\"\"\"\n",
        "    w = pesos_derivada(n, s, h)\n",
        "    xs = x0 + (np.arange(n+1) - s)*h\n",
        "    return np.exp(x0) - np.sum(w*np.exp(xs))\n",
        "\n",
        "hs = 0.1/2**np.arange(0, 7)\n",
        "resultados = {}\n",
        "print(f\"{'n':>2} {'s':>2} {'esquema':>9} | {'C teórico':>9} {'C medido':>10}\")\n",
        "for n in (2, 3):\n",
        "    for s in range(n+1):\n",
        "        errs = np.array([error_empirico(n, s, h) for h in hs])\n",
        "        pend = np.polyfit(np.log(hs), np.log(np.abs(errs)), 1)[0]\n",
        "        C_med = errs[-1]/(hs[-1]**n*np.exp(0.3))\n",
        "        resultados[(n, s)] = (errs, pend)\n",
        "        nom = {0: \"adelante\", n: \"atrás\"}.get(s, \"central\" if (n == 2 and s == 1) else \"interno\")\n",
        "        print(f\"{n:>2} {s:>2} {nom:>9} | {str(Fraction(coef_error(n, s)).limit_denominator(100)):>9} {C_med:>10.5f}\")\n",
