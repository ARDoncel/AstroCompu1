        "# @title\n",
        "def simpson(y, h):\n",
        "    \"\"\"Regla de Simpson compuesta sobre valores y[0..n] equiespaciados (n par).\"\"\"\n",
        "    return h/3*(y[0] + y[-1] + 4*y[1:-1:2].sum() + 2*y[2:-1:2].sum())\n",
        "\n",
        "def _integrandos_rebote(dipolo, L, alpha, n):\n",
        "    \"\"\"Cantidades sobre la línea de campo en la variable theta (lam = lam_m sin theta).\"\"\"\n",
        "    lam_m, _ = latitud_espejo(dipolo, L, alpha)\n",
        "    theta = np.linspace(0, np.pi/2, n + 1)\n",
        "    lam = lam_m*np.sin(theta)\n",
        "    dlam_dtheta = lam_m*np.cos(theta)\n",
        "    Bm = dipolo.B_ecuador(L)/np.sin(alpha)**2\n",
        "    raiz = np.sqrt(np.maximum(1 - dipolo.B_linea(L, lam)/Bm, 0.0))          # v_par / v\n",
        "    ds_dlam = L*dipolo.Re*np.cos(lam)*np.sqrt(1 + 3*np.sin(lam)**2)\n",
        "    return theta, raiz, ds_dlam*dlam_dtheta\n",
        "\n",
        "def integral_I(dipolo, L, alpha, n=400):\n",
        "    \"\"\"I = ∫ sqrt(1 - B/Bm) ds entre los dos espejos (Simpson).\"\"\"\n",
        "    theta, raiz, ds = _integrandos_rebote(dipolo, L, alpha, n)\n",
        "    return 2*simpson(raiz*ds, (np.pi/2)/n)\n",
        "\n",
        "def periodo_rebote_exacto(dipolo, L, alpha, v, n=400):\n",
        "    \"\"\"tau_b = 4/v * ∫_0^lam_m (ds/dlam) / sqrt(1 - B/Bm) dlam (Simpson).\"\"\"\n",
        "    theta, raiz, ds = _integrandos_rebote(dipolo, L, alpha, n)\n",
        "    y = np.zeros_like(raiz)\n",
        "    y[:-1] = ds[:-1]/raiz[:-1]\n",
        "    y[-1] = 2*y[-2] - y[-3]            # en el espejo hay 0/0: el integrando es suave, se extrapola\n",
        "    return 4/v*simpson(y, (np.pi/2)/n)\n",
        "\n",
        "def periodo_rebote_eq7(L, Re, v, alpha):\n",
        "    \"\"\"Aproximación: 4*1.3802*L*Re/v * [1 - 0.4635 sin^(3/4)(alpha)].\"\"\"\n",
        "    return 4*1.3802*L*Re/v*(1 - 0.4635*np.sin(alpha)**0.75)"
