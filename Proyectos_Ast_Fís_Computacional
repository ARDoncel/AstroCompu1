        "def base_perpendicular(b):\n",
        "    \"\"\"Dos vectores unitarios e1, e2 perpendiculares entre sí y a b.\"\"\"\n",
        "    a = np.array([1.0, 0.0, 0.0]) if abs(b[0]) < 0.9 else np.array([0.0, 1.0, 0.0])\n",
        "    e1 = a - (a @ b)*b\n",
        "    e1 = e1/norma(e1)\n",
        "    return e1, cruz(b, e1)\n",
        "\n",
        "def centro_guia_desde_particula(part, x, v, B):\n",
        "    \"\"\"R = x + (M/(q B^2)) v x B   (vale para un punto o para arreglos (N,3)).\"\"\"\n",
        "    B2 = np.sum(B*B, axis=-1, keepdims=True)\n",
        "    return x + np.cross(v, B)/(part.qM*B2)\n",
        "\n",
        "def estado_inicial(part, campo, R0, alpha, fase=0.0, iteraciones=6):\n",
        "    \"\"\"Devuelve (x0, v0) tal que el centro guía está en R0 y el ángulo de paso es alpha.\n",
        "    Con iteraciones=0 la partícula arranca exactamente en R0.\"\"\"\n",
        "    R0 = np.array(R0, float)\n",
        "    B = campo(R0)\n",
        "    b = B/norma(B)\n",
        "    e1, e2 = base_perpendicular(b)\n",
        "    v0 = part.rapidez*(np.cos(alpha)*b + np.sin(alpha)*(np.cos(fase)*e1 + np.sin(fase)*e2))\n",
        "    x0 = R0.copy()\n",
        "    for _ in range(iteraciones):                         # punto fijo: x0 = R0 - (M/qB^2) v x B(x0)\n",
        "        Bx = campo(x0)\n",
        "        x0 = R0 - cruz(v0, Bx)/(part.qM*(Bx @ Bx))\n",
        "    return x0, v0"
