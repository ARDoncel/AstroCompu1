        "c_luz   = 2.99792458e8        # m/s\n",
        "Re_m    = 6.378e6             # m, radio terrestre\n",
        "B0_T    = 3.07e-5             # T, campo ecuatorial en la superficie\n",
        "keV     = 1e3*e_carga         # J\n",
        "MeV     = 1e6*e_carga         # J\n",
        "\n",
        "class Particula:\n",
        "    \"\"\"\n",
        "    Partícula cargada. Guarda todo lo que el integrador necesita:\n",
        "      q      carga\n",
        "      m      masa en reposo\n",
        "      gamma  factor relativista (constante porque E=0)\n",
        "      rapidez |v|\n",
        "      M      masa efectiva gamma*m\n",
        "      qM     cociente q/M  (es lo único que aparece en la ecuación de movimiento)\n",
        "\n",
        "    Se puede crear con energía cinética Ec (no relativista si c=None,\n",
        "    relativista si se da c) o directamente con una rapidez.\n",
        "    \"\"\"\n",
        "    def __init__(self, q, m, Ec=None, rapidez=None, c=None):\n",
        "        self.q, self.m = q, m\n",
        "        if rapidez is not None:                    # rapidez dada, sin relatividad\n",
        "            self.gamma, self.rapidez = 1.0, rapidez\n",
        "        elif c is None:                            # Ec = 1/2 m v^2\n",
        "            self.gamma, self.rapidez = 1.0, np.sqrt(2*Ec/m)\n",
        "        else:                                      # Ec = (gamma-1) m c^2\n",
        "            self.gamma = 1.0 + Ec/(m*c**2)\n",
        "            self.rapidez = c*np.sqrt(1 - 1/self.gamma**2)\n",
        "        self.M  = self.gamma*self.m\n",
        "        self.qM = self.q/self.M\n",
        "\n",
        "    def mu(self, v_perp2, B):\n",
        "        \"\"\"Primer invariante adiabático, gamma^2 m v_perp^2 / (2B).\"\"\"\n",
        "        return self.gamma**2*self.m*v_perp2/(2*B)\n",
        "\n",
        "def cruz(a, b):\n",
        "    \"\"\"Producto cruz de dos vectores de 3 componentes (más rápido que np.cross).\"\"\"\n",
