        "# @title\n",
        "def biseccion(f, a, b, tol=1e-12, max_iter=200):\n",
        "    \"\"\"Raíz de f en [a,b] por bisección. Devuelve (raíz, número de iteraciones).\"\"\"\n",
        "    fa, fb = f(a), f(b)\n",
        "    if fa*fb > 0:\n",
        "        raise ValueError(\"f(a) y f(b) deben tener signos opuestos\")\n",
        "    for it in range(1, max_iter + 1):\n",
        "        m = 0.5*(a + b)\n",
        "        fm = f(m)\n",
        "        if fm == 0 or 0.5*(b - a) < tol:\n",
        "            return m, it\n",
        "        if fa*fm < 0:\n",
        "            b, fb = m, fm          # la raíz está en [a, m]\n",
        "        else:\n",
        "            a, fa = m, fm          # la raíz está en [m, b]\n",
        "    return 0.5*(a + b), max_iter\n",
        "\n",
        "def latitud_espejo(dipolo, L, alpha_eq, tol=1e-12):\n",
        "    \"\"\"\n",
        "    Latitud (rad) del punto espejo para la capa L y ángulo de paso ecuatorial alpha_eq.\n",
        "    Usa el campo vectorial del dipolo (dipolo.B) evaluado sobre la línea de campo.\n",
        "    \"\"\"\n",
        "    if abs(np.sin(alpha_eq) - 1.0) < 1e-14:\n",
        "        return 0.0, 0                                    # partícula ecuatorial: espejo en el ecuador\n",
        "    Bm = dipolo.B_ecuador(L)/np.sin(alpha_eq)**2\n",
        "    f = lambda lam: 1.0 - norma(dipolo.B(dipolo.punto_linea(L, lam)))/Bm     # ∝ v_par^2 / v^2\n",
        "    return biseccion(f, 0.0, np.radians(89.9), tol)\n",
        "\n",
