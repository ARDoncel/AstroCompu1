        "\n",
        "# 1) Las 10^5 iteraciones, guardando TODOS los pasos para revisar la energía en cada uno\n",
        "tray_completa = simular_particula(part_n, tabla_n, x0n, v0n, dt_n, N_n, cada=1, metodo=\"boris\")\n",
        "E_rel_todos = np.sum(tray_completa.v**2, axis=1)/np.sum(v0n**2) - 1\n",
        "print(f\"Iteraciones: {N_n} | tiempo simulado: {tray_completa.t[-1]:.1f}\")\n",
        "print(f\"Deriva máxima de la energía cinética en los {N_n} pasos: {np.max(np.abs(E_rel_todos)):.2e}  (límite: 1e-6)\")\n",
        "\n",
        "# 2) Para los diagnósticos usamos una muestra cada 10 pasos\n",
        "tray_n = Tray(tray_completa.t[::cada_n], tray_completa.x[::cada_n], tray_completa.v[::cada_n], tray_completa.cpu, \"boris\")\n",
        "diag_n = diagnosticos(part_n, tabla_n, tray_n)\n",
        "\n",
        "# 3) Puntos espejo por bisección vs simulación\n",
        "lam_m, iters = latitud_espejo(dip_n, L0, alpha0)\n",
        "lam_sim = np.max(np.abs(diag_n['lam']))\n",
        "print(f\"\\nPunto espejo (bisección, {iters} iteraciones): λ_m = {np.degrees(lam_m):.4f}°\")\n",
