        "# @title\n",
        "def pesos_lagrange(nodos, x):\n",
        "    \"\"\"Devuelve [l_0(x), ..., l_n(x)] para los nodos dados.\"\"\"\n",
        "    nodos = [float(v) for v in nodos]\n",
        "    n1 = len(nodos)\n",
        "    pesos = []\n",
        "    for j in range(n1):\n",
        "        lj = 1.0\n",
        "        for k in range(n1):\n",
        "            if k != j:\n",
        "                lj *= (x - nodos[k])/(nodos[j] - nodos[k])\n",
        "        pesos.append(lj)\n",
        "    return np.array(pesos)\n",
        "\n",
        "def interpolar_lagrange(nodos, valores, x):\n",
        "    \"\"\"Valor del polinomio de Lagrange que pasa por (nodos, valores), evaluado en x.\"\"\"\n",
        "    return pesos_lagrange(nodos, x) @ np.asarray(valores, float)\n",
        "\n",
        "# ---- Prueba: interpolar exp(x) en [0,1] ----\n",
        "print(\"n | Error\")\n",
        "x_prueba = 0.437\n",
        "for n in range(1, 7):\n",
        "    nodos = np.linspace(0, 1, n+1)\n",
        "    err_real = abs(interpolar_lagrange(nodos, np.exp(nodos), x_prueba) - np.exp(x_prueba))\n",
        "    print(f\"{n} | {err_real:.3e}\")"
