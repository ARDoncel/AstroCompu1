        "# @title\n",
        "class Tray:\n",
        "    \"\"\"Trayectoria: t (N,), x (N,3), v (N,3), más el tiempo de CPU y el nombre del método.\"\"\"\n",
        "    def __init__(self, t, x, v, cpu, metodo):\n",
        "        self.t, self.x, self.v, self.cpu, self.metodo = t, x, v, cpu, metodo\n",
        "\n",
        "def rhs_particula(part, campo):\n",
        "    \"\"\"Lado derecho f(y) de dy/dt = f(y) con y = (x, v).\"\"\"\n",
        "    def f(y):\n",
        "        return np.concatenate((y[3:], part.qM*cruz(y[3:], campo(y[:3]))))\n",
        "    return f\n",
        "\n",
        "def integrar(paso, y0, dt, N, cada=1):\n",
        "    \"\"\"Repite `paso(y, dt)` N veces y guarda el estado cada `cada` pasos (N debe ser múltiplo de cada).\"\"\"\n",
        "    n_guardados = N//cada + 1\n",
        "    Y = np.empty((n_guardados, len(y0)))\n",
        "    y = np.array(y0, float)\n",
        "    Y[0] = y\n",
        "    k = 1\n",
        "    for i in range(1, N + 1):\n",
        "        try:\n",
        "            y = paso(y, dt)\n",
        "        except ValueError as error:          # p.ej. la partícula salió de la tabla de campo\n",
        "            print(f\"   [integración detenida en t = {i*dt:.4g}: {error}]\")\n",
        "            break\n",
        "        if i % cada == 0:\n",
        "            Y[k] = y\n",
        "            k += 1\n",
        "    return dt*cada*np.arange(k), Y[:k]\n",
        "\n",
        "# ---------- Runge-Kutta 4 (sirve para cualquier ecuación dy/dt = f(y)) ----------\n",
        "def paso_rk4(f):\n",
        "    def paso(y, dt):\n",
        "        k1 = f(y)\n",
        "        k2 = f(y + 0.5*dt*k1)\n",
        "        k3 = f(y + 0.5*dt*k2)\n",
        "        k4 = f(y + dt*k3)\n",
        "        return y + dt/6*(k1 + 2*k2 + 2*k3 + k4)\n",
        "    return paso\n",
        "\n",
        "# ---------- Euler-Cromer ----------\n",
        "def paso_euler_cromer(part, campo):\n",
        "    def paso(y, dt):\n",
        "        x, v = y[:3], y[3:]\n",
        "        v_nueva = v + dt*part.qM*cruz(v, campo(x))     # 1) velocidad con la fuerza actual\n",
        "        x_nueva = x + dt*v_nueva                       # 2) posición con la velocidad NUEVA\n",
        "        return np.concatenate((x_nueva, v_nueva))\n",
        "    return paso\n",
        "\n",
        "# ---------- Boris (deriva - giro - deriva) ----------\n",
        "def girar_velocidad(v, B, qM, dt):\n",
        "    \"\"\"Rotación de Boris: gira v alrededor de B sin cambiar su módulo.\"\"\"\n",
        "    t = 0.5*dt*qM*B\n",
        "    s = 2*t/(1 + t @ t)\n",
        "    v_prima = v + cruz(v, t)\n",
        "    return v + cruz(v_prima, s)\n",
        "\n",
        "def paso_boris(part, campo):\n",
        "    def paso(y, dt):\n",
        "        x_medio = y[:3] + 0.5*dt*y[3:]                             # medio paso de posición\n",
        "        v_nueva = girar_velocidad(y[3:], campo(x_medio), part.qM, dt)  # giro con B en el punto medio\n",
        "        x_nueva = x_medio + 0.5*dt*v_nueva                         # otro medio paso\n",
        "        return np.concatenate((x_nueva, v_nueva))\n",
        "    return paso\n",
        "\n",
        "# ---------- Bulirsch-Stoer ----------\n",
        "def paso_bulirsch_stoer(f, secuencia=(2, 4, 6, 8)):\n",
        "    \"\"\"\n",
        "    Un paso grande H se calcula con la 'regla del punto medio modificada' usando n subpasos,\n",
        "    para n = 2, 4, 6, 8. Luego se extrapola a subpaso cero con la tabla de Richardson:\n",
        "        T[k][j] = T[k][j-1] + (T[k][j-1] - T[k-1][j-1]) / ((n_k/n_{k-j})^2 - 1)\n",
        "    \"\"\"\n",
        "    def paso(y, H):\n",
        "        T = []\n",
        "        for k, n in enumerate(secuencia):\n",
        "            h = H/n\n",
        "            z_ant, z = y, y + h*f(y)\n",
        "            for _ in range(1, n):\n",
        "                z_ant, z = z, z_ant + 2*h*f(z)                # punto medio: z_{m+1} = z_{m-1} + 2h f(z_m)\n",
        "            fila = [0.5*(z + z_ant + h*f(z))]                 # suavizado final de Gragg\n",
        "            for j in range(1, k + 1):\n",
        "                factor = (secuencia[k]/secuencia[k-j])**2 - 1\n",
        "                fila.append(fila[j-1] + (fila[j-1] - T[k-1][j-1])/factor)\n",
        "            T.append(fila)\n",
        "        return T[-1][-1]\n",
        "    return paso\n",
        "\n",
        "# ---------- Verlet posicional con la segunda derivada central ----------\n",
        "def simular_verlet(part, campo, x0, v0, dt, N, cada=1):\n",
        "    \"\"\"\n",
        "    (x_{i+1} - 2 x_i + x_{i-1})/dt^2 = qM * v_i x B_i,   con  v_i = (x_{i+1} - x_{i-1})/(2 dt).\n",
        "    Sustituyendo v_i queda un sistema lineal 3x3 para D = x_{i+1} - x_{i-1}:\n",
        "        D + b (B x D) = 2 (x_i - x_{i-1}),   b = dt*qM/2\n",
        "    cuya solución es  D = (w - b B x w + b^2 B (B.w)) / (1 + b^2 |B|^2),   w = 2 (x_i - x_{i-1}).\n",
        "    \"\"\"\n",
        "    x_ant = np.array(x0, float)\n",
        "    x_act = paso_boris(part, campo)(np.concatenate((x0, v0)), dt)[:3]     # primer paso para arrancar\n",
        "    b = 0.5*dt*part.qM\n",
        "    guardar_t, guardar_x, guardar_v = [0.0], [x_ant.copy()], [np.array(v0, float)]\n",
        "    for i in range(1, N + 1):\n",
        "        B = campo(x_act)\n",
        "        w = 2*(x_act - x_ant)\n",
        "        D = (w - b*cruz(B, w) + b*b*B*(B @ w))/(1 + b*b*(B @ B))\n",
        "        x_sig = x_ant + D\n",
        "        if i % cada == 0:\n",
        "            guardar_t.append(i*dt); guardar_x.append(x_act.copy()); guardar_v.append(D/(2*dt))\n",
        "        x_ant, x_act = x_act, x_sig\n",
        "    return np.array(guardar_t), np.array(guardar_x), np.array(guardar_v)\n",
        "\n",
        "def simular_particula(part, campo, x0, v0, dt, N, cada=1, metodo=\"boris\"):\n",
        "    \"\"\"Función única para llamar a cualquiera de los cinco integradores.\"\"\"\n",
        "    t_ini = time.perf_counter()\n",
        "    if metodo == \"verlet\":\n",
        "        t, x, v = simular_verlet(part, campo, x0, v0, dt, N, cada)\n",
        "    else:\n",
        "        pasos = {\"boris\": lambda: paso_boris(part, campo),\n",
        "                 \"rk4\": lambda: paso_rk4(rhs_particula(part, campo)),\n",
