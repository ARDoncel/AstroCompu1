        "# @title\n",
        "def gradiente_numerico(F, r, delta):\n",
        "    \"\"\"∇F(r) con la diferencia central de 3 nodos (pesos de la sección 2, n=2, s=1).\"\"\"\n",
        "    w = pesos_derivada(2, 1, delta)                     # = [-1/(2 delta), 0, +1/(2 delta)]\n",
        "    g = np.zeros(3)\n",
        "    for k in range(3):\n",
        "        e = np.zeros(3)\n",
        "        e[k] = delta\n",
        "        g[k] = w[0]*F(r - e) + w[1]*F(r) + w[2]*F(r + e)\n",
        "    return g\n",
        "\n",
        "def rhs_centro_guia(part, campo, mu_g, delta):\n",
        "    \"\"\"Lado derecho del centro guía. Estado y = (R_x, R_y, R_z, v_par).\"\"\"\n",
        "    modB = lambda r: norma(campo(r))\n",
        "    def f(y):\n",
        "        R, v_par = y[:3], y[3]\n",
        "        B = campo(R)\n",
        "        Bm = norma(B)\n",
        "        b = B/Bm\n",
        "        gB = gradiente_numerico(modB, R, delta)\n",
        "        v_perp2 = 2*mu_g*Bm/part.M\n",
        "        v_deriva = part.M/(2*part.q*Bm**2)*(v_perp2 + 2*v_par**2)*cruz(b, gB)   # gradiente + curvatura\n",
        "        dR = v_par*b + v_deriva\n",
        "        dv_par = -(mu_g/part.M)*(b @ gB)                                       # fuerza espejo\n",
        "        return np.append(dR, dv_par)\n",
        "    return f\n",
        "\n",
        "def paso_euler_cromer_cg(f):\n",
        "    def paso(y, dt):\n",
        "        v_par_nueva = y[3] + dt*f(y)[3]                        # 1) v_par con la fuerza actual\n",
        "        y_tmp = np.append(y[:3], v_par_nueva)\n",
        "        return np.append(y[:3] + dt*f(y_tmp)[:3], v_par_nueva) # 2) R con la v_par nueva\n",
        "    return paso\n",
        "\n",
        "def paso_leapfrog_cg(f):\n",
        "    \"\"\"Empujón-deriva-empujón: medio paso de v_par, paso de R evaluado en el punto medio, medio paso de v_par.\"\"\"\n",
        "    def paso(y, dt):\n",
        "        v_medio = y[3] + 0.5*dt*f(y)[3]                                    # medio empujón en v_par\n",
        "        R_medio = y[:3] + 0.5*dt*f(np.append(y[:3], v_medio))[:3]          # R a mitad del paso\n",
        "        R_nuevo = y[:3] + dt*f(np.append(R_medio, v_medio))[:3]            # paso completo con pendiente central\n",
        "        y_nuevo = np.append(R_nuevo, v_medio)\n",
        "        return np.append(R_nuevo, v_medio + 0.5*dt*f(y_nuevo)[3])          # otro medio empujón\n",
        "    return paso\n",
        "\n",
        "def simular_cg(part, campo, R0, alpha, dt, N, cada=1, metodo=\"rk4\", delta=None):\n",
        "    \"\"\"Integra el centro guía desde R0 con ángulo de paso alpha (medido en R0).\"\"\"\n",
        "    R0 = np.array(R0, float)\n",
        "    B0 = norma(campo(R0))\n",
        "    v_par0 = part.rapidez*np.cos(alpha)\n",
        "    mu_g = part.M*(part.rapidez*np.sin(alpha))**2/(2*B0)\n",
        "    if delta is None:\n",
        "        delta = 1e-4*norma(R0)\n",
        "    f = rhs_centro_guia(part, campo, mu_g, delta)\n",
        "    pasos = {\"rk4\": paso_rk4(f), \"euler_cromer\": paso_euler_cromer_cg(f),\n",
        "             \"leapfrog\": paso_leapfrog_cg(f), \"bulirsch_stoer\": paso_bulirsch_stoer(f)}\n",
        "    t_ini = time.perf_counter()\n",
        "    t, Y = integrar(pasos[metodo], np.append(R0, v_par0), dt, N, cada)\n",
        "    cpu = time.perf_counter() - t_ini\n",
        "    return dict(t=t, R=Y[:, :3], v_par=Y[:, 3], mu_g=mu_g, cpu=cpu, metodo=metodo)\n",
        "\n",
        "# ---- Verificación 1: el gradiente numérico contra el analítico en el ecuador (dB/dr = -3B/r) ----\n",
        "dip_g = Dipolo(B_sup=1.0, Re=1.0)\n",
