        "# @title\n",
        "def diagnosticos(part, campo, tray):\n",
        "    \"\"\"Calcula energía, mu, centro guía y coordenadas dipolares a partir de una trayectoria.\"\"\"\n",
        "    x, v = tray.x, tray.v\n",
        "    B = np.array([campo(p) for p in x])  # B en la posición exacta\n",
        "    Bm = np.linalg.norm(B, axis=1)\n",
        "    v2 = np.sum(v*v, axis=1)\n",
        "    v_par = np.sum(v*B, axis=1)/Bm\n",
        "    v_perp2 = v2 - v_par**2\n",
        "    R = centro_guia_desde_particula(part, x, v, B)\n",
        "    r = np.linalg.norm(R, axis=1)\n",
        "    lam = np.arcsin(R[:, 2]/r)\n",
        "    return dict(t=tray.t, B=Bm, E_rel=(v2 - v2[0])/v2[0],\n",
        "                mu=part.mu(v_perp2, Bm), E_perp=0.5*part.M*v_perp2, E_par=0.5*part.M*v_par**2,\n",
        "                R=R, r=r, lam=lam, L=r/np.cos(lam)**2, phi=np.unwrap(np.arctan2(R[:, 1], R[:, 0])))\n",
        "\n",
        "def promedio_movil(y, ventana):\n",
        "    \"\"\"Promedio móvil simple (ventana impar); devuelve un arreglo del mismo largo (bordes recortados).\"\"\"\n",
        "    k = np.ones(ventana)/ventana\n",
        "    z = np.convolve(y, k, mode='same')\n",
        "    m = ventana//2\n",
        "    z[:m], z[-m:] = np.nan, np.nan\n",
        "    return z\n",
        "\n",
        "def cruces_ascendentes(t, z):\n",
        "    \"\"\"Instantes (interpolados linealmente) en que z pasa de negativo a positivo.\"\"\"\n",
        "    idx = np.where((z[:-1] < 0) & (z[1:] >= 0))[0]\n",
        "    return t[idx] - z[idx]*(t[idx+1] - t[idx])/(z[idx+1] - z[idx])\n",
        "\n",
        "def periodo_rebote_medido(t, z_cg):\n",
        "    c = cruces_ascendentes(t, z_cg)\n",
        "    return np.mean(np.diff(c)) if len(c) > 1 else np.nan\n",
        "\n",
        "def periodo_deriva_medido(t, phi_desenrollada):\n",
        "    \"\"\"Devuelve (periodo, omega) con omega la pendiente de phi(t); su signo da el sentido (+ = hacia el este).\"\"\"\n",
        "    omega = np.polyfit(t, phi_desenrollada, 1)[0]\n",
        "    return 2*np.pi/abs(omega), omega\n",
        "\n",
        "def medir_periodos(t, R):\n",
        "    \"\"\"\n",
        "    Periodos de rebote y de deriva a partir del centro guía R(t) (arreglo (N,3)).\n",
        "    Se usan los cruces ascendentes del ecuador: la deriva se mide entre el primer y el último cruce\n",
        "    (mismo instante del rebote), así no influye la oscilación de la longitud durante el rebote.\n",
        "    Devuelve (T_rebote, T_deriva, omega) con omega>0 hacia el este y omega<0 hacia el oeste.\n",
        "    \"\"\"\n",
        "    phi = np.unwrap(np.arctan2(R[:, 1], R[:, 0]))\n",
        "    c = cruces_ascendentes(t, R[:, 2])\n",
        "    T_reb = (c[-1] - c[0])/(len(c) - 1)\n",
        "    ph = np.interp(c, t, phi)\n",
        "    omega = (ph[-1] - ph[0])/(c[-1] - c[0])\n",
        "    return T_reb, 2*np.pi/abs(omega), omega\n",
        "\n",
        "def periodo_deriva_teoria(part, dipolo, L, alpha):\n",
        "    \"\"\"\n",
        "    Deriva de gradiente de una partícula ecuatorial (exacta):  T90 = 4 pi |q| B0 Re^3 / (3 M v^2 R0).\n",
        "    Para otros ángulos de paso se usa el promedio sobre el rebote (aprox. estándar):  T = T90 / (0.7 + 0.3 sin(alpha)).\n",
        "    \"\"\"\n",
        "    R0 = L*dipolo.Re\n",
        "    T90 = 4*np.pi*abs(part.q)*dipolo.B_sup*dipolo.Re**3/(3*part.M*part.rapidez**2*R0)\n",
        "    return T90/(0.7 + 0.3*np.sin(alpha))\n",
        "\n",
        "def resumen_particula(part, B_local, rho_ref=None):\n",
        "    \"\"\"Frecuencia y radio de giro para un campo local B y v_perp = rapidez (giro puro).\"\"\"\n",
        "    Om = abs(part.qM)*B_local\n",
        "    return Om, part.rapidez/Om"
      ]
