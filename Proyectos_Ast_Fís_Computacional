        "# @title\n",
        "x0e, v0e = estado_inicial(part_n, tabla_n, [L0, 0.0, 0.0], np.pi/2)          # ángulo de paso 90°\n",
        "dt_e, N_e, cada_e = 0.005, 41000, 5                                            # ~1 periodo de deriva\n",
        "tray_e = simular_particula(part_n, tabla_n, x0e, v0e, dt_e, N_e, cada=cada_e, metodo=\"boris\")\n",
        "diag_e = diagnosticos(part_n, tabla_n, tray_e)\n",
        "B_en_R = np.array([norma(tabla_n(p)) for p in diag_e['R']])                     # B evaluado en el centro guía\n",
        "r_cg = diag_e['r']\n",
        "\n",
        "T_d_teo_e = periodo_deriva_teoria(part_n, dip_n, L0, np.pi/2)\n",
        "T_d_med_e, omega_e = periodo_deriva_medido(tray_e.t, diag_e['phi'])\n",
        "pend_r = np.polyfit(tray_e.t, r_cg, 1)[0]                                      # tendencia secular de r_cg\n",
        "print(f\"\\n|z| máximo de la partícula: {np.max(np.abs(tray_e.x[:, 2])):.1e}  (debe ser ~0: se queda en el plano ecuatorial)\")\n",
        "print(f\"r del centro guía: entre {r_cg.min():.4f} y {r_cg.max():.4f}; cambio secular en todo el recorrido = {pend_r*tray_e.t[-1]:+.2e} R_E\")\n",
        "print(f\"B en el centro guía: variación relativa máxima respecto a B_eq = {np.max(np.abs(B_en_R/Beq_n - 1)):.2e}\")\n",
        "print(f\"Promediando sobre ~10 giros: r del centro guía queda entre {np.nanmin(promedio_movil(r_cg, 241)):.4f} y {np.nanmax(promedio_movil(r_cg, 241)):.4f}; \"\n",
        "      f\"B entre {100*(np.nanmin(promedio_movil(B_en_R, 241))/Beq_n-1):+.2f} % y {100*(np.nanmax(promedio_movil(B_en_R, 241))/Beq_n-1):+.2f} % de B_eq\")\n",
        "print(f\"Periodo de deriva: medido = {T_d_med_e:.3f} | teoría = {T_d_teo_e:.3f} | sentido: {'oeste (φ decrece)' if omega_e < 0 else 'este'}\")\n",
        "\n",
        "fig, axs = plt.subplots(1, 3, figsize=(14, 4.4))\n",
        "ax = axs[0]\n",
        "ax.plot(tray_e.x[:, 0], tray_e.x[:, 1], lw=0.4, color='tab:blue', label=\"partícula\")\n",
        "ax.plot(diag_e['R'][:, 0], diag_e['R'][:, 1], color='tab:red', lw=1.2, label=\"centro guía\")\n",
        "th = np.linspace(0, 2*np.pi, 300); ax.plot(L0*np.cos(th), L0*np.sin(th), 'k--', lw=0.8, label=\"contorno B = const (r = 8)\")\n",
        "ax.plot(0, 0, 'o', color='steelblue', ms=8); ax.set_aspect('equal'); ax.set_title(\"(a) Órbita vista desde el polo norte\")\n",
        "ax.set_xlabel(\"x (R_E)\"); ax.set_ylabel(\"y (R_E)\"); ax.legend(fontsize=7, loc='upper right')\n",
        "ax = axs[1]\n",
        "w_s = 241                                                                       # ventana ≈ 10 giros\n",
        "r_s, B_s = promedio_movil(r_cg, w_s), promedio_movil(B_en_R, w_s)\n",
        "ax.plot(tray_e.t, (r_cg/L0 - 1)*100, lw=0.3, color='lightsteelblue', label=\"r del centro guía (instantáneo)\")\n",
        "ax.plot(tray_e.t, (r_s/L0 - 1)*100, color='tab:blue', label=\"r del centro guía (promedio de 10 giros)\")\n",
        "ax.plot(tray_e.t, (B_s/Beq_n - 1)*100, color='tab:orange', label=\"B en el centro guía (promedio de 10 giros)\")\n",
        "ax.set_xlabel(\"tiempo\"); ax.set_ylabel(\"variación respecto al valor inicial (%)\"); ax.set_title(\"(b) El centro guía se queda en r = L\"); ax.legend(fontsize=7)\n",
        "ax = axs[2]\n",
        "ax.plot(tray_e.t, np.degrees(diag_e['phi']), label=\"simulación\"); ax.plot(tray_e.t, -360*tray_e.t/T_d_teo_e, 'k--', label=\"teoría\")\n",
        "ax.set_xlabel(\"tiempo\"); ax.set_ylabel(\"longitud del centro guía (grados)\"); ax.set_title(\"(c) Deriva hacia el oeste\"); ax.legend(fontsize=8)\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "def fondo_ecuador(ax):\n",
        "    ax.plot(L0*np.cos(th), L0*np.sin(th), 'k--', lw=0.8); ax.plot(0, 0, 'o', color='steelblue', ms=9)\n",
        "anim = animar_2d([tray_e.x[:, :2], diag_e['R'][:, :2]], [\"partícula\", \"centro guía\"], \"Partícula ecuatorial (vista desde el polo norte)\",\n",
        "                 n_frames=90, cola=400, fondo=fondo_ecuador, estilos=[{'lw': 0.6}, {'lw': 1.6}])\n",
        "mostrar_animacion(anim)"
