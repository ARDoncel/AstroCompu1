      "source": [
        "# @title\n",
        "B_u = lambda r: np.array([0.0, 0.0, 1.0])                  # B = 1 T en la dirección z\n",
        "especies = [(\"q=1, m=1\", 1.0, 1.0), (\"q=2, m=1\", 2.0, 1.0), (\"q=1, m=2\", 1.0, 2.0), (\"q=-1, m=1\", -1.0, 1.0)]\n",
        "v0_u = np.array([1.0, 0.0, 0.5])                           # v_perp = 1 m/s, v_par = 0.5 m/s\n",
        "dt_u, N_u = 0.01, 2500                                     # 25 s: al menos 2 vueltas de la más lenta\n",
        "\n",
        "trays_u, err_omega, err_rho = [], 0.0, 0.0\n",
        "print(f\"{'especie':>10} | {'Ω teórica':>10} {'Ω medida':>10} | {'ρ teórico':>10} {'ρ medido':>10}\")\n",
        "for nombre, q, m in especies:\n",
        "    p = Particula(q, m, rapidez=norma(v0_u))\n",
        "    tr = simular_particula(p, B_u, np.zeros(3), v0_u, dt_u, N_u, metodo=\"boris\")\n",
        "    trays_u.append(tr.x)\n",
        "    Om_teo, rho_teo = p.qM*1.0, m*1.0/abs(q)               # Ω con signo; rho = M v_perp/(|q| B)\n",
        "    angulo_v = np.unwrap(np.arctan2(tr.v[:, 1], tr.v[:, 0]))\n",
        "    Om_med = -np.polyfit(tr.t, angulo_v, 1)[0]              # v gira en sentido horario para q>0\n",
        "    rho_med = 0.25*(np.ptp(tr.x[:, 0]) + np.ptp(tr.x[:, 1]))\n",
        "    err_omega = max(err_omega, abs(Om_med/Om_teo - 1)); err_rho = max(err_rho, abs(rho_med/rho_teo - 1))\n",
        "    print(f\"{nombre:>10} | {Om_teo:10.4f} {Om_med:10.4f} | {rho_teo:10.4f} {rho_med:10.4f}\")\n",
        "\n",
        "fig = plt.figure(figsize=(11, 4.5))\n",
        "ax = fig.add_subplot(121, projection='3d')\n",
        "for (nombre, q, m), x in zip(especies, trays_u):\n",
        "    ax.plot(x[:, 0], x[:, 1], x[:, 2], lw=1, label=nombre)\n",
        "ax.quiver(0, 0, 0, 0, 0, 1, color='purple', length=10.0, arrow_length_ratio=0.2, normalize=True, label=r'$\\vec{B}$')\n",
        "ax.set_xlabel(\"x (m)\"); ax.set_ylabel(\"y (m)\"); ax.set_zlabel(\"z (m)\"); ax.set_title(\"Hélices en campo uniforme\"); ax.legend(fontsize=8)\n",
        "ax = fig.add_subplot(122)\n",
        "for (nombre, q, m), x in zip(especies, trays_u):\n",
        "    ax.plot(x[:, 0], x[:, 1], lw=1, label=nombre)\n",
        "ax.set_aspect('equal'); ax.set_xlabel(\"x (m)\"); ax.set_ylabel(\"y (m)\"); ax.set_title(\"Proyección en el plano perpendicular a B\"); ax.legend(fontsize=8)\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "anim = animar_3d([x[::10] for x in trays_u], [e[0] for e in especies], \"Hélices en campo uniforme\", n_frames=60, cola=80, aspecto=(1, 1, 1.4))\n",
        "mostrar_animacion(anim)"
      ]
