        "# @title\n",
        "class TablaB:\n",
        "    \"\"\"\n",
        "    Tabla del campo dipolar en (varpi, z) + interpolación de Lagrange cúbica 4x4.\n",
        "      n : número de celdas de la malla por cada L*Re (h = L*Re/n)\n",
        "    Se usa como función:  tabla(r)  ->  vector B en la posición r = (x, y, z).\n",
        "    \"\"\"\n",
        "    NODOS = np.array([-1.0, 0.0, 1.0, 2.0])     # 4 nodos vecinos, en unidades de h\n",
        "\n",
        "    def __init__(self, dipolo, L, n=200, varpi_rel=(0.05, 1.3), z_rel=0.6):\n",
        "        R0 = L*dipolo.Re\n",
        "        self.h = R0/n\n",
        "        self.varpi0 = varpi_rel[0]*R0\n",
        "        n_varpi = int((varpi_rel[1] - varpi_rel[0])*R0/self.h) + 1\n",
        "        n_z = int(z_rel*R0/self.h)\n",
        "        self.z0 = -n_z*self.h                    # así z=0 cae exactamente sobre un nodo\n",
        "        varpi = self.varpi0 + self.h*np.arange(n_varpi)\n",
        "        z = self.z0 + self.h*np.arange(2*n_z + 1)\n",
        "        VV, ZZ = np.meshgrid(varpi, z, indexing='ij')\n",
        "        B = dipolo.B(np.stack([VV, np.zeros_like(VV), ZZ], axis=-1))   # y=0  ->  x=varpi\n",
        "        self.B_varpi, self.B_z = B[..., 0], B[..., 2]\n",
        "        self.forma = self.B_varpi.shape\n",
        "\n",
        "    def __call__(self, r):\n",
        "        x, y, z = float(r[0]), float(r[1]), float(r[2])\n",
        "        varpi = np.sqrt(x*x + y*y)\n",
        "        fi, fk = (varpi - self.varpi0)/self.h, (z - self.z0)/self.h\n",
        "        i, k = int(np.floor(fi)), int(np.floor(fk))\n",
        "        if i < 1 or k < 1 or i + 2 >= self.forma[0] or k + 2 >= self.forma[1]:\n",
        "            raise ValueError(f\"La partícula salió de la tabla de campo (varpi={varpi:.3g}, z={z:.3g})\")\n",
        "        wi = pesos_lagrange(self.NODOS, fi - i)      # pesos en la dirección varpi\n",
        "        wk = pesos_lagrange(self.NODOS, fk - k)      # pesos en la dirección z\n",
        "        Bp = wi @ self.B_varpi[i-1:i+3, k-1:k+3] @ wk\n",
        "        Bz = wi @ self.B_z[i-1:i+3, k-1:k+3] @ wk\n",
        "        return np.array([Bp*x/varpi, Bp*y/varpi, Bz])\n",
        "\n",
