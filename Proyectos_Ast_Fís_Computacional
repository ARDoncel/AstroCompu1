      "source": [
        "# @title\n",
        "def pesos_derivada(n, s, h=1.0):\n",
        "    \"\"\"\n",
        "    Pesos w_j de la derivada primera en el nodo s, usando n+1 nodos x_j = j*h.\n",
        "        f'(x_s) ≈ sum_j w_j * f(x_j)\n",
        "    Se calculan derivando los polinomios de Lagrange (fórmulas de Singh y Thorpe).\n",
        "    \"\"\"\n",
        "    x = np.arange(n+1)*h\n",
        "    w = np.zeros(n+1)\n",
        "    for j in range(n+1):\n",
        "        if j == s:\n",
        "            w[j] = sum(1.0/(x[s]-x[k]) for k in range(n+1) if k != s)\n",
        "        else:\n",
        "            num = np.prod([x[s]-x[k] for k in range(n+1) if k != j and k != s])\n",
        "            den = np.prod([x[j]-x[k] for k in range(n+1) if k != j])\n",
        "            w[j] = num/den\n",
        "    return w"
      ]
