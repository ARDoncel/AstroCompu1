        "# @title\n",
        "def resolver_giro(n, s, theta, K):\n",
        "    \"\"\"\n",
        "    Resuelve u' = i*Omega*u con la fórmula de derivada (n,s), con theta = Omega*h.\n",
        "    Cada esquema da una recurrencia; se despeja el dato más nuevo u[k].\n",
        "    \"\"\"\n",
        "    w = pesos_derivada(n, s, 1.0)          # pesos con h=1 (theta ya incluye a h)\n",
        "    u = np.zeros(K, dtype=complex)\n",
        "    u[:n] = np.exp(1j*theta*np.arange(n))  # valores de arranque exactos\n",
        "    for k in range(n, K):\n",
        "        m = k - n + s                      # instante donde se evalúa la derivada\n",
        "        resto = -sum(w[j]*u[k-n+j] for j in range(n))\n",
        "        coef = w[n]\n",
        "        if s < n:\n",
        "            resto += 1j*theta*u[m]         # el término i*Omega*u_m ya se conoce\n",
        "        else:\n",
        "            coef -= 1j*theta               # s = n: u_m es la incógnita (esquema implícito)\n",
        "        u[k] = resto/coef\n",
        "    return u\n",
        "\n",
        "theta, K = 0.5, 120                     # theta = Omega*h: 0.5 rad por paso (unos 13 pasos por vuelta)\n",
        "fig, ax = plt.subplots(figsize=(7, 4))\n",
        "amplitudes = {}\n",
        "for s, nom in [(0, \"adelante\"), (1, \"central\"), (2, \"atrás\")]:\n",
        "    u = resolver_giro(2, s, theta, K)\n",
        "    amplitudes[nom] = np.abs(u)\n",
        "    ax.semilogy(np.abs(u), label=nom)\n",
        "ax.axhline(1, color='k', ls=':', label=\"exacto |u|=1\")\n",
        "ax.set_ylim(1e-2, 1e8); ax.set_xlabel(\"paso k\"); ax.set_ylabel(\"|u| (amplitud)\")\n",
        "ax.set_title(\"Integración de Oscilación (Esquema de 3 nodos)\"); ax.legend()\n",
        "plt.tight_layout(); plt.show()"
