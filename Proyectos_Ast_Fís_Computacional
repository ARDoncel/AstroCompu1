        "# @title\n",
        "N_anim = int(3.05*tau_b_n/dt_n)\n",
        "tr_a = simular_particula(part_n, tabla_n, x0n, v0n, dt_n, N_anim, cada=2, metodo=\"boris\")\n",
        "d_a = diagnosticos(part_n, tabla_n, tr_a)\n",
        "lam_l = np.linspace(-np.radians(90), np.radians(90), 200)\n",
        "linea = np.array([dip_n.punto_linea(L0, l) for l in lam_l])\n",
        "\n",
        "n_frames = 80\n",
        "fig = plt.figure(figsize=(11, 4.8), dpi=65)\n",
        "ax3 = fig.add_subplot(121, projection='3d'); ax2 = fig.add_subplot(122)\n",
        "lo, hi = tr_a.x.min(axis=0) - 0.2, tr_a.x.max(axis=0) + 0.2\n",
        "ax3.set_xlim(lo[0] - 0.5, hi[0] + 0.5)\n",
        "ax3.set_ylim(lo[1] - 0.5, hi[1] + 0.5)\n",
        "ax3.set_zlim(lo[2] - 0.5, hi[2] + 0.5)\n",
        "ax3.set_box_aspect(tuple(hi - lo)); ax3.view_init(elev=0, azim=-45)\n",
        "ax3.plot(linea[:, 0], linea[:, 1], linea[:, 2], 'k:', lw=0.8)\n",
        "ax3.plot(-linea[:, 0], -linea[:, 1], linea[:, 2], 'k:', lw=0.8)\n",
        "ax3.plot([0], [0], [0], 'o', color='steelblue', ms=15)\n",
        "ax3.set_xlabel(\"x\"); ax3.set_ylabel(\"y\"); ax3.set_zlabel(\"z\"); ax3.set_title(\"Partícula (hélice)\")\n",
        "l3, = ax3.plot([], [], [], lw=0.8, color='tab:blue'); p3, = ax3.plot([], [], [], 'o', color='tab:red', ms=5)\n",
        "vp_a = np.hypot(tr_a.x[:, 0], tr_a.x[:, 1])\n",
        "ax2.plot(linea[:, 0], linea[:, 2], 'k:', lw=0.8, label=\"línea de campo L = 8\")\n",
        "ax2.plot([0], [0], 'o', color='steelblue', ms=15)\n",
        "for s_ in (+1, -1):\n",
        "    ax2.plot(*dip_n.punto_linea(L0, s_*lam_m)[[0, 2]], 'r^' if s_ > 0 else 'rv', ms=9)\n",
        "ax2.set_xlim(0, vp_a.max() + 0.3); ax2.set_ylim(-4.2, 4.2); ax2.set_xlabel(\"ϖ\"); ax2.set_ylabel(\"z\"); ax2.set_title(\"Plano meridiano: rebote entre espejos (▲▼)\")\n",
        "l2, = ax2.plot([], [], lw=0.6, color='tab:blue'); p2, = ax2.plot([], [], 'o', color='tab:red', ms=5); g2, = ax2.plot([], [], '-', color='tab:green', lw=1.2, label=\"centro guía\")\n",
        "ax2.legend(fontsize=8, loc='upper left')\n",
        "def actualizar_rebote(f):\n",
        "    i = int((len(tr_a.x) - 1)*f/(n_frames - 1)); j = max(0, i - 500)\n",
        "    l3.set_data(tr_a.x[j:i+1, 0], tr_a.x[j:i+1, 1]); l3.set_3d_properties(tr_a.x[j:i+1, 2])\n",
        "    p3.set_data(tr_a.x[i:i+1, 0], tr_a.x[i:i+1, 1]); p3.set_3d_properties(tr_a.x[i:i+1, 2])\n",
        "    l2.set_data(vp_a[j:i+1], tr_a.x[j:i+1, 2]); p2.set_data(vp_a[i:i+1], tr_a.x[i:i+1, 2])\n",
        "    g2.set_data(np.hypot(d_a['R'][:i+1, 0], d_a['R'][:i+1, 1]), d_a['R'][:i+1, 2])\n",
        "    return l3, p3, l2, p2, g2\n",
        "anim = animation.FuncAnimation(fig, actualizar_rebote, frames=n_frames, interval=60, blit=False)\n",
        "mostrar_animacion(anim)"
