        "# @title\n",
        "class Dipolo:\n",
        "    \"\"\"\n",
        "    Campo dipolar terrestre.\n",
        "      B_sup : intensidad del campo en el ecuador a distancia r = Re (el B0 del PDF)\n",
        "      Re    : radio terrestre en las unidades de longitud que se usen\n",
        "    Todas las posiciones son vectores (x, y, z) en las mismas unidades que Re.\n",
        "    \"\"\"\n",
        "    def __init__(self, B_sup, Re):\n",
        "        self.B_sup, self.Re = B_sup, Re\n",
        "\n",
        "    def B(self, r):\n",
        "        \"\"\"Campo vectorial, Ec. (6) del PDF. Acepta un punto (3,) o muchos (...,3).\"\"\"\n",
        "        r = np.asarray(r, float)\n",
        "        x, y, z = r[..., 0], r[..., 1], r[..., 2]\n",
        "        k = self.B_sup*self.Re**3/(x*x + y*y + z*z)**2.5\n",
        "        return np.stack([-3*x*z*k, -3*y*z*k, (x*x + y*y - 2*z*z)*k], axis=-1)\n",
        "\n",
        "    def B_eq5(self, r):\n",
        "        \"\"\"El mismo campo escrito con la forma vectorial de la Ec. (5) (para verificar la Ec. 6).\"\"\"\n",
        "        r = np.asarray(r, float)\n",
        "        rn = np.linalg.norm(r, axis=-1, keepdims=True)\n",
        "        rh = r/rn\n",
        "        Mh = np.array([0.0, 0.0, -1.0])                     # dirección del momento dipolar\n",
        "        return self.B_sup*self.Re**3/rn**3*(3*np.sum(Mh*rh, axis=-1, keepdims=True)*rh - Mh)\n",
        "\n",
        "    def B_ecuador(self, L):\n",
        "        \"\"\"Intensidad en el ecuador de la capa L.\"\"\"\n",
        "        return self.B_sup/L**3\n",
        "\n",
        "    def B_linea(self, L, lam):\n",
        "        \"\"\"Intensidad sobre la línea de campo de la capa L, en la latitud lam (radianes).\"\"\"\n",
        "        return self.B_ecuador(L)*np.sqrt(1 + 3*np.sin(lam)**2)/np.cos(lam)**6\n",
        "\n",
        "    def punto_linea(self, L, lam):\n",
        "        \"\"\"Punto (x,0,z) de la línea de campo L a latitud lam.\"\"\"\n",
        "        R0 = L*self.Re\n",
        "        return np.array([R0*np.cos(lam)**3, 0.0, R0*np.cos(lam)**2*np.sin(lam)])"
      ]
