        "L_r, alpha_r = 4.0, np.radians(45.0)\n",
        "dip_r = Dipolo(B_sup=B0_T, Re=Re_m)\n",
        "tabla_r = TablaB(dip_r, L_r)\n",
        "R0_r = np.array([L_r*Re_m, 0.0, 0.0])\n",
        "Beq_r = dip_r.B_ecuador(L_r)\n",
        "\n",
        "def ajustar_circulo(x, y):\n",
        "    \"\"\"\n",
        "    Círculo por mínimos cuadrados: x² + y² + A x + B y + C = 0  ->  centro (-A/2, -B/2), radio sqrt(cx²+cy²-C).\n",
        "    Las ecuaciones normales (3x3) se resuelven con Cramer y determinantes por cofactores.\n",
        "    \"\"\"\n",
        "    mx, my = x.mean(), y.mean()\n",
        "    u, w = x - mx, y - my\n",
        "    M = np.column_stack((u, w, np.ones_like(u)))\n",
        "    b = -(u**2 + w**2)\n",
        "    N, rhs = M.T @ M, M.T @ b\n",
        "    D = det_cofactores(N)\n",
        "    sol = []\n",
        "    for j in range(3):\n",
        "        Nj = N.copy(); Nj[:, j] = rhs\n",
        "        sol.append(det_cofactores(Nj)/D)\n",
        "    A, B, C = sol\n",
        "    cx, cy = -A/2, -B/2\n",
        "    return cx + mx, cy + my, np.sqrt(cx**2 + cy**2 - C)\n",
        "\n",
        "resultados_pe = {}\n",
        "for nombre, q, m in [(\"protón\", e_carga, m_p), (\"electrón\", -e_carga, m_e)]:\n",
        "    p = Particula(q, m, Ec=1*MeV, c=c_luz)\n",
        "    Om = abs(p.qM)*Beq_r\n",
        "    T_c = 2*np.pi/Om\n",
        "    tau_b = periodo_rebote_exacto(dip_r, L_r, alpha_r, p.rapidez)\n",
        "    dt = T_c/60\n",
        "    N = int(round(4*tau_b/dt/20))*20\n",
        "    x0, v0 = estado_inicial(p, tabla_r, R0_r, alpha_r)\n",
        "    tr = simular_particula(p, tabla_r, x0, v0, dt, N, cada=1, metodo=\"boris\")\n",
        "    paso_dec = max(1, N//6000)\n",
        "    tr_dec = Tray(tr.t[::paso_dec], tr.x[::paso_dec], tr.v[::paso_dec], tr.cpu, \"boris\")\n",
        "    d = diagnosticos(p, tabla_r, tr_dec)\n",
        "    x0_90, v0_90 = estado_inicial(p, tabla_r, R0_r, np.pi/2)                     # partícula ecuatorial: solo gira\n",
